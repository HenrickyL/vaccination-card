# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

# Copia tudo para o contexto de build
COPY . .

# Restaura dependências
RUN dotnet restore src/VaccinationCard.Api

# Publica em modo Release
RUN dotnet publish src/VaccinationCard.Api \
    -c Release \
    --no-restore \
    -o /app

# ── Stage 2: runtime ───────────────────────────────────────────────────────────
# Imagem final muito menor: só o ASP.NET runtime, sem o SDK
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

WORKDIR /app

COPY --from=build /app .

ENTRYPOINT ["dotnet", "VaccinationCard.Api.dll"]